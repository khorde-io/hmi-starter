# Copy to .env.local and fill in the client ID from Apps → New app
# in your Hub's control plane (http://localhost:8085/ui/apps).

VITE_AUTHORITY=http://auth.localhost:9310
VITE_CLIENT_ID=

# Only needed if the Hub isn't on the default local quickstart address.
# The WebSocket endpoint for subscriptions is derived from this one.
# VITE_GRAPHQL_URL=http://localhost:8085/
